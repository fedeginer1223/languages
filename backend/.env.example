# Database
DATABASE_URL="postgresql://user:password@localhost:5432/language_learning?schema=public"

# Server
PORT=3002
NODE_ENV=development

# Auth (obligatorio en producción): cadena larga y aleatoria
SESSION_SECRET=change-me-long-random

# Claude API
ANTHROPIC_API_KEY=your_api_key_here
BOOK_ANNOTATION_MODEL=claude-sonnet-5-5
STRUCTURE_JUDGE_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY= # (no usado actualmente)

# Clave de la API externa (/api/v1/ext/*, cabecera X-API-Key). Vacía = API desactivada
EXTERNAL_API_KEY=
